# NextAuth / Auth.js Configuration
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token-placeholder # For source maps upload (CI/CD only)
SENTRY_ORG=your-org
SENTRY_PROJECT=sorotask-frontend
SENTRY_DEBUG=false # Enable debug logs in development

# GitHub OAuth (optional - for GitHub authentication)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth (optional - for Google authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Assistant Configuration
# OpenAI API Key for AI-powered task configuration assistant
NEXT_PUBLIC_OPENAI_API_KEY=sk-placeholder_your_openai_api_key_here

# OpenAI Model Selection
NEXT_PUBLIC_OPENAI_MODEL=gpt-4-turbo-preview
NEXT_PUBLIC_OPENAI_TEMPERATURE=0.7
NEXT_PUBLIC_OPENAI_MAX_TOKENS=2000
NEXT_PUBLIC_AI_DEBUG=false

# Indexer GraphQL URL
NEXT_PUBLIC_INDEXER_URL=http://localhost:4000/graphql

# Secret Store Integration (AWS Secrets Manager or HashiCorp Vault)
# SECRET_STORE_PROVIDER=aws # or 'vault'
# AWS_SECRETS_MANAGER_SECRET_ID=sorotask/frontend/production
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_SECRET_PATH=secret/data/sorotask/frontend
