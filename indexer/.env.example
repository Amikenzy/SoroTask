# Indexer Configuration
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# Soroban Network RPC
SOROBAN_RPC_URL=https://rpc-futurenet.stellar.org
NETWORK_PASSPHRASE=Test SDF Future Network ; October 2022
CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Database Path
DATABASE_URL=./indexer.db

# Authentication & JWT (Placeholder)
JWT_SECRET=your_sanitized_jwt_secret_placeholder_here

# Secret Store Integration (AWS Secrets Manager or HashiCorp Vault)
# SECRET_STORE_PROVIDER=aws # or 'vault'
# AWS_SECRETS_MANAGER_SECRET_ID=sorotask/indexer/production
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_SECRET_PATH=secret/data/sorotask/indexer
